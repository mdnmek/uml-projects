@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase{
    BackgroundColor LightGreen
    BorderColor DarkGreen
    ArrowColor DarkGreen
}

actor "Пользователь платформы" as BaseUser
actor "Студент" as Student
actor "Преподаватель" as Teacher
actor "Администратор" as Admin
actor "Родитель" as Parent

BaseUser <|-- Student
BaseUser <|-- Teacher
BaseUser <|-- Admin
BaseUser <|-- Parent

rectangle "Платформа онлайн-школы"{
    'действия студента
    usecase "Просмотр курсов" as UC_ViewCourses
    usecase "Прохождение занятия" as UC_TakeLesson
    usecase "Сдача домашнего задания" as UC_SubmitHW
    usecase "Просмотр оценок" as UC_ViewGrades
    usecase "Написание вопроса" as UC_AskQuestion

    'действия преподавателя
    usecase "Создание курса" AS UC_CreateCourse
    usecase "Проверка ДЗ" AS UC_CheckHW
    usecase "Проведение вебинара" as UC_Webinar
    usecase "Выставление оценок" as UC_Grade
    usecase "Ответ на вопрос" as UC_Answer

    'действия администратора
    usecase "Управление пользователями" as UC_ManageUsers
    usecase "Формирование отчетов" as UC_Reports
    usecase "Настройка системы" as UC_Config
    usecase "Управление расписанием" as UC_Schedule
    usecase "Модерация контента" as UC_Moderate

    'действия родителя
    usecase "Оплата обучения" as UC_Pay
    usecase "Просмотр успеваемости" as UC_ViewProgress
    usecase "Связь с преподавателем" as UC_ContactTeacher
    usecase "Просмотр расписания" as UC_ViewSchedule
    usecase "Настройка уведомлений" as UC_Notifications   

    'дополнительные сценарии 
    usecase "Проверка доступа к курсу" as UC_CheckAccess
    usecase "Запись вебинара" as UC_RecordWebinar
    usecase "Проверка статуса оплаты" as UC_CheckPayment
    usecase "Скачивание сертификата" as UC_DownloadCert    
    
}

'строим связи между actors и usecase

'связи студента
Student --> UC_ViewCourses
Student --> UC_TakeLesson
Student --> UC_SubmitHW
Student --> UC_ViewGrades
Student --> UC_AskQuestion

'связи преподавателя
Teacher --> UC_CreateCourse
Teacher --> UC_CheckHW
Teacher --> UC_Webinar
Teacher --> UC_Grade
Teacher --> UC_Answer

'связи администратора
Admin --> UC_ManageUsers
Admin --> UC_Reports
Admin --> UC_Config
Admin --> UC_Schedule
Admin --> UC_Moderate

'связи родителя
Parent --> UC_Pay
Parent --> UC_ViewProgress
Parent --> UC_ContactTeacher
Parent --> UC_ViewSchedule
Parent --> UC_Notifications

' связи Include
UC_TakeLesson ..> UC_CheckAccess : <<include>>
UC_Webinar ..> UC_RecordWebinar : <<include>>
UC_Pay ..> UC_CheckPayment : <<include>>

' Связи Extend с точками расширения
UC_AskQuestion .> UC_TakeLesson : <<extend>>\n(Точка расширения: В процессе урока)
UC_DownloadCert .> UC_ViewProgress : <<extend>>\n(Точка расширения: Курс успешно завершен)

' заметки с описанием точек расширения
note right of UC_TakeLesson
  **Точки расширения:**
  • В процессе урока
  • При возникновении вопроса
end note

note right of UC_ViewProgress
  **Точки расширения:**
  • Курс успешно завершен
  • Оценка выше проходного балла
end note

@enduml