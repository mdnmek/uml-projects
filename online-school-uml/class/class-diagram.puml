@startuml
title Диаграмма классов: Модель онлайн-школы

' Базовый класс
abstract class Пользователь {
  -id: UUID
  -email: String
  -passwordHash: String
  -role: Role
  +login()
  +logout()
}

' Наследники
class Студент {
  -studentId: String
  -group: String
  +просмотретьКурсы()
  +пройтиУрок()
  +сдатьДЗ()
  +просмотретьОценки()
  +задатьВопрос()
}

class Преподаватель {
  -teacherId: String
  -specialization: String
  +создатьКурс()
  +проверитьДЗ()
  +провестиВебинар()
  +выставитьОценку()
  +ответитьНаВопрос()
}

class Администратор {
  -adminId: String
  +управлятьПользователями()
  +формироватьОтчеты()
  +настраиватьСистему()
  +управлятьРасписанием()
  +модерироватьКонтент()
}

class Родитель {
  -parentId: String
  +оплатитьОбучение()
  +просмотретьУспеваемость()
  +связатьсяСПреподавателем()
  +просмотретьРасписание()
  +настроитьУведомления()
}

' Основные сущности
class Курс {
  -courseId: UUID
  -title: String
  -price: Decimal
  -isPublished: Boolean
  +опубликовать()
  +добавитьУрок()
}

class Урок {
  -lessonId: UUID
  -title: String
  -videoUrl: String
  -order: Int
}

class Задание {
  -taskId: UUID
  -description: Text
  -deadline: Date
  +проверить()
}

class Оценка {
  -gradeId: UUID
  -value: Int
  -comment: String
  -date: Date
}

class Вебинар {
  -webinarId: UUID
  -date: DateTime
  -link: String
  -recordUrl: String
}

class Вопрос {
  -questionId: UUID
  -text: Text
  -date: DateTime
  -answer: Text
}

class Оплата {
  -paymentId: UUID
  -amount: Decimal
  -date: DateTime
  -status: String
}

class Уведомление {
  -notificationId: UUID
  -text: String
  -date: DateTime
  -isRead: Boolean
}

class Расписание {
  -scheduleId: UUID
  -date: Date
  -time: Time
  -type: String
}

class Сертификат {
  -certId: UUID
  -issueDate: Date
  -url: String
}

class Отчет {
  -reportId: UUID
  -type: String
  -date: Date
  -data: Text
}

' Наследование
Пользователь <|-- Студент
Пользователь <|-- Преподаватель
Пользователь <|-- Администратор
Пользователь <|-- Родитель

' Связи
Студент "1" --> "*" Курс : записан на
Преподаватель "1" --> "*" Курс : ведет
Курс "1" *--> "*" Урок : содержит
Урок "1" *--> "*" Задание : включает
Студент "1" --> "*" Оценка : получает
Задание "1" --> "*" Оценка : оценивается

Преподаватель "1" --> "*" Вебинар : проводит
Курс "1" --> "*" Вебинар : включает

Студент "1" --> "*" Вопрос : задает
Преподаватель "1" --> "*" Вопрос : отвечает
Вопрос "*" --> "1" Урок : относится к

Родитель "1" --> "*" Студент : контролирует
Родитель "1" --> "*" Оплата : совершает
Оплата "*" --> "1" Курс : за

Пользователь "1" --> "*" Уведомление : получает
Администратор "1" --> "*" Расписание : управляет
Администратор "1" --> "*" Отчет : формирует
Студент "1" --> "*" Сертификат : получает
Курс "1" <-- "*" Сертификат : выдается за

@enduml